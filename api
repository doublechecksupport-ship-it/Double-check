module.exports = async function handler(req, res) {
  res.setHeader('Content-Type', 'application/json');
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed.' });
  }

  try {
    const { documentText, detailLevel = 2 } = req.body || {};

    if (!documentText || documentText.length < 20) {
      return res.status(400).json({ error: 'Document text is too short or missing.' });
    }

    // Simulated clean response payload matching your app structure
    const mockSummary = {
      docTitle: "MASTER PROFESSIONAL SERVICES AGREEMENT",
      executiveSummary: "This agreement outlines the standard terms and conditions governing professional services, detailing payment terms, confidentiality obligations, and standard liability caps for the engagement.",
      categories: [
        { title: "Purpose & Scope", content: "Defines the scope of professional services and deliverables expected under this contract." },
        { title: "Financial Terms", content: "Outlines billing rates, invoicing frequency, and standard payment schedules." },
        { title: "Term & Termination", content: "Specifies agreement duration and conditions for early termination with written notice." },
        { title: "Confidentiality & IP", content: "Protects proprietary information and establishes ownership rights over deliverables." },
        { title: "Liability & Risk Caps", content: "Limits overall financial and legal liability to the fees paid under the contract." },
        { title: "Governing Law", content: "Subject to the local jurisdiction and laws governing the contract." },
        { title: "Dispute Resolution", content: "Mandates good-faith negotiation followed by arbitration for unresolved disputes." },
        { title: "Auto-Renewal & Lock-Ins", content: "Outlines automatic renewal clauses and notice periods required to opt out." }
      ]
    };

    return res.status(200).json(mockSummary);

  } catch (err) {
    return res.status(500).json({ error: 'Server error: ' + err.message });
  }
};
