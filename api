export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    const { documentText } = req.body || {};
    const apiKey = process.env.GEMINI_API_KEY;

    if (!apiKey) {
      return res.status(500).json({ error: 'GEMINI_API_KEY missing.' });
    }

    const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`;
    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ parts: [{ text: "Summarize this contract briefly: " + documentText }] }]
      })
    });

    const data = await response.json();
    if (!response.ok) {
      return res.status(500).json({ error: data.error?.message || 'API failed' });
    }

    const textOutput = data.candidates[0].content.parts[0].text;
    
    // Temporary fallback JSON structure to match frontend expectations
    return res.status(200).json({
      docTitle: "CONTRACT_SUMMARY",
      executiveSummary: textOutput,
      categories: [
        { title: "Overview", content: textOutput }
      ]
    });
  } catch (err) {
    return res.status(500).json({ error: err.message });
  }
}
