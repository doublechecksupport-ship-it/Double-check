async function summarise() {
    const text = document.getElementById('contractInput').value;
    if (!text.trim()) return alert("Please enter legal text to analyze.");

    const apiKey = "YOUR_GROQ_API_KEY_HERE"; // Paste your gsk_... key here

    try {
        const response = await fetch("https://api.groq.com/openai/v1/chat/completions", {
            method: "POST",
            headers: {
                "Authorization": `Bearer ${apiKey}`,
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                model: "llama-3.3-70b-versatile",
                messages: [
                    {
                        role: "system",
                        content: "You are an expert legal assistant. Analyze the document and respond ONLY with valid JSON in this structure: {\"docTitle\": \"Title\", \"executiveSummary\": \"Overview...\", \"categories\": [{\"title\": \"Category\", \"content\": \"Details...\"}]}"
                    },
                    {
                        role: "user",
                        content: text
                    }
                ],
                response_format: { type: "json_object" }
            })
        });

        const data = await response.json();
        const content = JSON.parse(data.choices[0].message.content);
        
        // Render results in your UI
        renderResults(content);
    } catch (err) {
        console.error("AI Error:", err);
        alert("AI Error: " + err.message);
    }
}
