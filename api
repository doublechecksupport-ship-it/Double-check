module.exports = async function handler(req, res) {
  // 1. Force JSON responses & CORS headers
  res.setHeader('Content-Type', 'application/json');
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  // Handle preflight browser requests
  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  // Reject non-POST requests
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed. Use POST.' });
  }

  try {
    const { documentText, detailLevel = 2 } = req.body || {};

    // Validate input text length
    if (!documentText || documentText.length < 20) {
      return res.status(400).json({ error: 'Document text is too short or missing.' });
    }

    // Retrieve environment variable
    const apiKey = process.env.GEMINI_API_KEY;
    if (!apiKey) {
      return res.status(500).json({ error: 'GEMINI_API_KEY is not set in Vercel settings.' });
    }

    // System prompt requesting strict JSON output
    const prompt = `You are an expert legal AI assistant. Analyze the following contract text and return valid JSON only.

Detail level: ${detailLevel} (1=Short, 2=Medium, 3=Detailed).

Return strictly valid JSON matching this schema:
{
  "docTitle": "Title of the contract",
  "executiveSummary": "A concise overview paragraph",
  "categories": [
    {"title": "Purpose & Scope", "content": "Summary..."},
    {"title": "Financial Terms", "content": "Summary..."},
    {"title": "Term & Termination", "content": "Summary..."},
    {"title": "Confidentiality & IP", "content": "Summary..."},
    {"title": "Liability & Risk Caps", "content": "Summary..."},
    {"title": "Governing Law", "content": "Summary..."},
    {"title": "Dispute Resolution", "content": "Summary..."},
    {"title": "Auto-Renewal & Lock-Ins", "content": "Summary..."}
  ]
}

Contract Text:
${documentText}`;

    // Direct REST endpoint for Gemini 1.5 Flash
    const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`;

    const apiResponse = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ parts: [{ text: prompt }] }],
        generationConfig: { responseMimeType: 'application/json' }
      })
    });

    const rawResponseBody = await apiResponse.text();

    // Safely parse raw response from Google
    let geminiData;
    try {
      geminiData = JSON.parse(rawResponseBody);
    } catch (parseErr) {
      return res.status(500).json({ error: 'Failed to parse Google API response: ' + rawResponseBody });
    }

    // Handle Google API errors (e.g. invalid API key or model error)
    if (!apiResponse.ok) {
      return res.status(apiResponse.status).json({
        error: geminiData.error?.message || 'Google Gemini API returned an error.'
      });
    }

    // Extract text output and parse the JSON string generated by the AI
    const jsonStringFromAI = geminiData.candidates[0].content.parts[0].text;
    const finalStructuredData = JSON.parse(jsonStringFromAI);

    return res.status(200).json(finalStructuredData);

  } catch (err) {
    return res.status(500).json({ error: 'Backend server error: ' + err.message });
  }
};
